<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Base64 Patcher</title>
<style>
  :root{
    --bg:#0f1115; --panel:#171a21; --panel2:#1e2229; --border:#2a2f3a;
    --text:#e6e9ef; --muted:#8a90a0; --accent:#4f8cff; --accent2:#37c98a;
    --danger:#ff5c5c; --mono:'Consolas','SFMono-Regular',Menlo,monospace;
  }
  *{box-sizing:border-box;}
  body{
    background:var(--bg); color:var(--text); font-family:Segoe UI,Arial,sans-serif;
    margin:0; padding:24px; min-height:100vh;
  }
  h1{font-size:18px; font-weight:600; margin:0 0 4px;}
  .sub{color:var(--muted); font-size:13px; margin-bottom:20px;}
  .layout{display:grid; grid-template-columns:360px 1fr; gap:16px; align-items:start;}
  @media(max-width:900px){.layout{grid-template-columns:1fr;}}
  .panel{
    background:var(--panel); border:1px solid var(--border); border-radius:8px; padding:16px;
  }
  .drop{
    border:2px dashed var(--border); border-radius:8px; padding:28px 12px; text-align:center;
    color:var(--muted); cursor:pointer; transition:border-color .15s, color .15s; font-size:14px;
    min-height:44px; display:flex; align-items:center; justify-content:center;
  }
  .drop.drag{border-color:var(--accent); color:var(--text);}
  .drop input{display:none;}
  .filemeta{margin-top:12px; font-size:12px; color:var(--muted); word-break:break-all;}
  button{
    background:var(--accent); color:#fff; border:none; border-radius:8px; padding:12px 18px;
    font-size:14px; cursor:pointer; font-weight:600; min-height:44px;
  }
  button.secondary{background:var(--panel2); color:var(--text); border:1px solid var(--border);}
  button.green{background:var(--accent2);}
  button:disabled{opacity:.4; cursor:not-allowed;}
  .row{display:flex; gap:10px; margin-top:10px; flex-wrap:wrap; align-items:center;}
  .row button{flex:1 1 auto;}
  label{font-size:13px; color:var(--muted); display:block; margin:14px 0 4px;}
  input[type=number]{
    width:70px; background:var(--panel2); border:1px solid var(--border); color:var(--text);
    border-radius:6px; padding:10px; font-size:14px; min-height:40px;
  }
  .checkrow{display:flex; align-items:center; gap:8px; font-size:13px; color:var(--muted); margin-top:12px;}
